pkgname=ecpilot
pkgver=0.1.0
pkgrel=1
install=ecpilot.install
pkgdesc="MSI laptop control center rewritten with Rust and GPUI"
arch=('x86_64')
url="https://github.com/"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'fontconfig' 'vulkan-icd-loader' 'polkit')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/ecpilot "$pkgdir/usr/bin/ecpilot"
  install -Dm755 target/release/ecpilot-helper "$pkgdir/usr/bin/ecpilot-helper"
  install -Dm644 packaging/ecpilot-helper.service "$pkgdir/usr/lib/systemd/system/"
  install -Dm644 packaging/ecpilot-helper.conf "$pkgdir/usr/share/dbus-1/system.d/"
  install -Dm644 packaging/ecpilot.desktop "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/ecpilot-wayland.desktop "$pkgdir/usr/share/applications/"
  install -Dm644 assets/icons/ecpilot.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/ecpilot.svg"
  for size in 16 24 32 48 64 128 256; do
    install -Dm644 "assets/icons/ecpilot-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ecpilot.png"
  done
  sed -i 's|/usr/local/libexec/ecpilot-helper|/usr/bin/ecpilot-helper|' \
    "$pkgdir/usr/lib/systemd/system/ecpilot-helper.service"
}
